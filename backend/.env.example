# Copy to .env and fill in. Used by docker-compose (backend) and local uvicorn.

# --- Database ---
# In docker-compose this is overridden to point at the `db` service.
DATABASE_URL=postgresql+asyncpg://monoclip:monoclip@localhost:5432/monoclip

# --- JWT ---
# REQUIRED. The app refuses to start if this is empty or left as the placeholder.
# Generate a strong random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- OAuth: Google ---
# Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://127.0.0.1:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OAuth: GitHub ---
# Settings > Developer settings > OAuth Apps
# Authorization callback URL: http://127.0.0.1:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public base URL of THIS backend (used to build OAuth redirect_uri).
OAUTH_REDIRECT_BASE=http://127.0.0.1:8000

# Desktop custom protocol the OAuth callback redirects the token to.
APP_DEEP_LINK=monoclip://auth

# --- Email (Gmail SMTP) for signup verification codes ---
# Used to email the 6-digit code during registration. You MUST use a Gmail
# "App Password", not your normal password (see backend/README or the steps
# below). Leave SMTP_USER/SMTP_PASSWORD blank in development to skip real email
# — the code is printed to the backend logs instead.
#
# Setup:
#   1. Enable 2-Step Verification on the Google account (required for app pwds):
#      https://myaccount.google.com/signinoptions/twosv
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#      Pick "Mail" / "Other (MonoClip)". Google shows a 16-character password.
#   3. SMTP_USER = that Gmail address, SMTP_PASSWORD = the 16 chars (no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=MonoClip

# Verification code behaviour.
OTP_LENGTH=6
OTP_EXPIRE_SECONDS=600
OTP_MAX_ATTEMPTS=5
